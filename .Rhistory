Samples_90pct = n_90,
Max_Samples = length(acc$sites),
Max_Observed_Richness = max(acc$richness)
))
}
# Run for all groups
results_tbl <- imap_dfr(species_list, samples_to_target)
# View results
print(results_tbl)
save(list=ls(),file= here::here("working/RData", "Workplan_Fish_code_04.RData"))
